/* app.wxss - 全局样式：深蓝 / 科技蓝 / 浅灰，与 PC Web 同一设计语言 */
/* V2.0 设计令牌与组件类（不改动下方 V1 的 .tw-* 类，旧页面零回归） */
@import "styles/tokens.wxss";

page {
  --tw-color-bg: #edf1f6;
  --tw-color-surface: #ffffff;
  --tw-color-primary: #0b2a4a;
  --tw-color-accent: #1e6fe0;
  --tw-color-text: #16263a;
  --tw-color-text-secondary: #5d7186;
  --tw-color-border: #e2e8f0;
  --tw-color-ok: #0fa896;     /* 正常 - 青绿 */
  --tw-color-watch: #e8902a;  /* 关注 - 橙 */
  --tw-color-danger: #d84c4c; /* 高风险 - 红 */
  --tw-color-offline: #94a3b8;

  /*
   * 关键：page 底色与各 V2 页面根容器（--m-bg #edf1f6）统一。
   * Tab 切换是原生对新页面 webview 的切换，样式首帧应用前会先透出 page 底色；
   * 底色不一致（曾为 #f2f5f9）就表现为白色/浅色空档。这里全站统一，消除闪白。
   */
  background-color: #edf1f6;
  color: var(--tw-color-text);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.tw-card {
  background: var(--tw-color-surface);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(11, 42, 74, 0.06);
}

.tw-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--tw-color-primary);
  margin-bottom: 16rpx;
}

.tw-muted {
  color: var(--tw-color-text-secondary);
  font-size: 24rpx;
}

/* 状态徽标：颜色必须配合文字，不仅靠颜色 */
.tw-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tw-badge-ok { background: rgba(18, 165, 148, 0.12); color: var(--tw-color-ok); }
.tw-badge-watch { background: rgba(232, 144, 42, 0.12); color: var(--tw-color-watch); }
.tw-badge-danger { background: rgba(216, 76, 76, 0.12); color: var(--tw-color-danger); }
.tw-badge-offline { background: rgba(148, 163, 184, 0.16); color: #475569; }

/* 数据来源标签：官方 / 模拟 / 人工 必须显式区分 */
.tw-source-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  border: 1rpx solid var(--tw-color-border);
  color: var(--tw-color-text-secondary);
  background: #fff;
}

/* 按钮 */
.tw-btn-primary {
  background: var(--tw-color-accent);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.tw-btn-primary[disabled] {
  opacity: 0.5;
}

/* 四态占位 */
.tw-state {
  text-align: center;
  color: var(--tw-color-text-secondary);
  padding: 96rpx 32rpx;
  font-size: 26rpx;
}

.tw-page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--tw-color-primary);
  margin: 8rpx 0 20rpx;
}

/* 语音现场感知（P11） */
.voice-btn {
  margin-left: 12rpx;
  font-size: 22rpx;
  background: #f0f6ff;
  color: #1e6fe0;
  border: 1rpx solid #1e6fe0;
}
.voice-btn-active {
  background: #d84c4c;
  color: #fff;
  border-color: #d84c4c;
}
.voice-tag {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-size: 20rpx;
}
.voice-plugin { background: rgba(30,111,224,.12); color: #1e6fe0; }
.voice-manual { background: rgba(148,163,184,.2); color: #5d7186; }
.voice-hint { margin-top: 8rpx; font-size: 22rpx; color: #e8902a; }
