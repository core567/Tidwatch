<view class="container">
  <!-- 实时连接状态（文字+颜色，不仅靠颜色） -->
  <view class="ws-bar ws-{{wsState}}">
    实时通道：{{wsStateText}}
    <text wx:if="{{newTaskBadge > 0}}" class="new-badge">{{newTaskBadge}}</text>
  </view>

  <block wx:if="{{uiState === 'loading'}}">
    <view class="tw-state">加载中…</view>
  </block>

  <block wx:elif="{{uiState === 'error'}}">
    <view class="tw-state">
      <view>任务加载失败</view>
      <view class="tw-muted err-msg">{{errorMsg}}</view>
      <button class="tw-btn-primary retry-btn" bindtap="loadTasks">重试</button>
    </view>
  </block>

  <block wx:elif="{{uiState === 'empty'}}">
    <view class="tw-state">当前没有分配给你的巡检任务</view>
  </block>

  <block wx:else>
    <view
      wx:for="{{tasks}}"
      wx:key="taskId"
      class="tw-card task-card"
      data-id="{{item.taskId}}"
      bindtap="openTask"
    >
      <view class="task-head">
        <text class="task-title">{{item.title}}</text>
        <text class="tw-badge {{item.priority === 'HIGH' ? 'tw-badge-danger' : item.priority === 'NORMAL' ? 'tw-badge-watch' : 'tw-badge-ok'}}">
          {{item.priority === 'HIGH' ? '高优先级' : item.priority === 'NORMAL' ? '普通' : '低'}}
        </text>
      </view>
      <view class="task-meta">
        <text>{{reachNames[item.reachId] || item.reachId}}</text>
        <text class="tw-muted">·</text>
        <text class="tw-muted">{{actionNames[item.actionType] || item.actionType}}</text>
      </view>
      <view class="task-foot">
        <text class="tw-muted">截止 {{item.dueAt ? item.dueAtText : '无'}}</text>
        <text class="tw-badge {{item.status === 'PENDING' ? 'tw-badge-watch' : 'tw-badge-ok'}}">{{statusNames[item.status] || item.status}}</text>
      </view>
    </view>
  </block>
</view>
