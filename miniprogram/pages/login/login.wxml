<view class="login">
  <view class="login-brand">
    <view class="login-title">TideWatch</view>
    <view class="login-sub">智慧河流水环境监测 · 移动巡检端</view>
  </view>

  <view class="tw-card login-form">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        placeholder="请输入账号"
        value="{{username}}"
        bindinput="onUsername"
        maxlength="32"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPassword"
        maxlength="64"
      />
    </view>

    <view wx:if="{{errorMsg}}" class="login-error">{{errorMsg}}</view>

    <button
      class="tw-btn-primary login-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >登录</button>

    <view class="login-note">
      账号由 PC 端系统管理统一分配（管理员 / 分析人员 / 巡检人员）。
      开发期后端未启动时登录将提示网络错误，属正常现象。
    </view>
  </view>
</view>
