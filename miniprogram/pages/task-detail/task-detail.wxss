.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.row-top {
  align-items: flex-start;
}
.reason {
  max-width: 440rpx;
  text-align: right;
}
.link-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.link {
  color: #1e6fe0;
  font-weight: 600;
}
.actions {
  margin-top: 12rpx;
}
.err-msg {
  margin: 16rpx 0 24rpx;
}
.retry-btn {
  width: 240rpx;
  margin-top: 16rpx;
}
.hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
