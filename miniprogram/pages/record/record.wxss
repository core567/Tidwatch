/* pages/record/record.wxss V2 */
.rc {
  min-height: 100vh;
  background: var(--m-bg);
}
.rc-hero { padding-top: 24rpx; padding-bottom: 48rpx; }
.rc-hero-top { display: flex; justify-content: space-between; gap: 20rpx; align-items: flex-start; }
.rc-task-name { font-size: 31rpx; font-weight: 800; color: #fff; line-height: 1.45; flex: 1; }
.rc-hero-chips { display: flex; gap: 12rpx; margin-top: 16rpx; flex-wrap: wrap; }
.rc-chip {
  font-size: 21rpx; padding: 7rpx 20rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.11); border: 1rpx solid rgba(255, 255, 255, 0.17); color: #dcebfa;
}
.rc-sheet { position: relative; z-index: 3; margin-top: -28rpx; padding: 0 28rpx; }

/* 退回横幅 */
.rc-reject {
  background: rgba(216, 76, 76, 0.07);
  border: 1rpx solid rgba(216, 76, 76, 0.32);
  border-left: 8rpx solid var(--m-danger);
  border-radius: var(--m-radius-md);
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}
.rc-reject-t { font-size: 26rpx; font-weight: 800; color: var(--m-danger); }
.rc-reject-c { font-size: 25rpx; margin-top: 10rpx; line-height: 1.6; color: #4a3535; }
.rc-reject-f { margin-top: 12rpx; font-size: 21rpx; color: var(--m-text-2); display: flex; justify-content: space-between; }

.rc-sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }

/* 复测行 */
.rc-measure {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx dashed #edf1f6;
}
.rc-measure:last-of-type { border-bottom: 0; }
.rc-measure-icon {
  width: 70rpx; height: 70rpx; border-radius: 20rpx;
  background: rgba(24, 183, 200, 0.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0;
}
.rc-measure-main { flex: 1; min-width: 0; }
.rc-measure-name { font-size: 26rpx; font-weight: 800; color: var(--m-navy-800); }
.rc-tag-req {
  font-size: 18rpx; font-weight: 700; color: var(--m-accent);
  background: rgba(30, 111, 224, 0.1); border-radius: 8rpx;
  padding: 2rpx 12rpx; margin-left: 10rpx;
}
.rc-measure-sub { font-size: 20rpx; color: var(--m-text-3); margin-top: 4rpx; }
.rc-measure-err { font-size: 20rpx; color: var(--m-danger); margin-top: 4rpx; }
.rc-unmeasured {
  margin-top: 8rpx; font-size: 21rpx; color: var(--m-watch); font-weight: 600;
  background: rgba(232, 144, 42, 0.1); border-radius: 8rpx; padding: 6rpx 14rpx;
  display: inline-block;
}
.rc-unmeasured-clear { color: var(--m-text-3); margin-left: 12rpx; text-decoration: underline; }
.rc-input {
  width: 150rpx; border: 1rpx solid var(--m-border); border-radius: 16rpx;
  padding: 14rpx 18rpx; font-size: 29rpx; font-weight: 800;
  text-align: right; color: var(--m-navy-800); background: #f7fafd;
}
.rc-input.is-err { border-color: var(--m-danger); color: var(--m-danger); }
.rc-unit { font-size: 22rpx; color: var(--m-text-2); width: 48rpx; font-weight: 700; }
.rc-reason-btn {
  font-size: 20rpx; color: var(--m-watch); border: 1rpx solid rgba(232, 144, 42, 0.5);
  border-radius: 999rpx; padding: 8rpx 18rpx; flex-shrink: 0;
}
.rc-step { display: flex; align-items: center; gap: 14rpx; }
.rc-step-btn {
  width: 58rpx; height: 58rpx; border-radius: 16rpx; border: 1rpx solid var(--m-border);
  background: #fff; color: var(--m-accent); font-size: 32rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; line-height: 1;
}
.rc-step-val { width: 36rpx; text-align: center; font-weight: 800; font-size: 32rpx; color: var(--m-navy-800); }
.rc-rule-note {
  margin-top: 18rpx; font-size: 20rpx; color: var(--m-text-3);
  background: #f8fafc; border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.6;
}

/* 语音 / textarea */
.rc-voice {
  font-size: 21rpx; font-weight: 700; color: var(--m-accent);
  background: rgba(30, 111, 224, 0.08); border: 1rpx solid rgba(30, 111, 224, 0.32);
  border-radius: 999rpx; padding: 10rpx 22rpx; line-height: 1.6;
}
.rc-voice::after { border: 0; }
.rc-voice.rec { background: var(--m-danger); border-color: var(--m-danger); color: #fff; }
.rc-textarea {
  width: 100%; min-height: 180rpx; border: 1rpx solid var(--m-border);
  border-radius: 18rpx; padding: 20rpx; font-size: 26rpx;
  background: #f7fafd; line-height: 1.65; box-sizing: border-box;
}
.rc-char { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.rc-voice-hint { margin-top: 8rpx; font-size: 21rpx; color: var(--m-watch); }

/* 照片 */
.rc-photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rc-photo { width: 128rpx; height: 128rpx; border-radius: 16rpx; position: relative; overflow: hidden; }
.rc-photo-img { width: 100%; height: 100%; background: linear-gradient(135deg, #9dbbd6, #6e93b8); }
.rc-photo-status {
  position: absolute; left: 0; right: 0; bottom: 0;
  font-size: 16rpx; text-align: center; background: rgba(7, 30, 56, 0.72);
  color: #fff; padding: 3rpx 0;
}
.rc-photo-status.st-failed { background: rgba(216, 76, 76, 0.85); }
.rc-photo-retry {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255, 255, 255, 0.95);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: var(--m-danger); font-size: 18rpx; font-weight: 800; gap: 2rpx;
}
.rc-photo-del {
  position: absolute; top: 2rpx; right: 2rpx; width: 34rpx; height: 34rpx;
  border-radius: 50%; background: rgba(7, 30, 56, 0.6); color: #fff;
  font-size: 24rpx; display: flex; align-items: center; justify-content: center; line-height: 1;
}
/* 拍照 / 相册 双入口 */
.rc-cam-actions { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.rc-cam-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  padding: 24rpx 0; border-radius: 16rpx;
  border: 2rpx solid var(--m-border); background: #fafcfe;
}
.rc-cam-btn.is-camera {
  border-color: rgba(30, 111, 224, 0.4);
  background: rgba(30, 111, 224, 0.05);
}
.rc-cam-btn.is-album:active,
.rc-cam-btn.is-camera:active { opacity: 0.75; }
.rc-cam-ic {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #103964, #189ab4);
}
.rc-cam-btn.is-album .rc-cam-ic {
  background: linear-gradient(135deg, #0e8c99, #18b7c8);
}
.rc-cam-label { font-size: 24rpx; font-weight: 700; color: var(--m-navy-800); }

/* 纯 CSS 摄像头图标 */
.rc-ic-camera {
  position: relative; width: 34rpx; height: 26rpx;
  border: 3rpx solid #fff; border-radius: 6rpx; box-sizing: border-box;
}
.rc-ic-camera::before {
  content: ''; position: absolute; top: -8rpx; left: 6rpx;
  width: 12rpx; height: 6rpx; background: #fff; border-radius: 3rpx 3rpx 0 0;
}
.rc-ic-camera::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 12rpx; height: 12rpx; margin: -6rpx 0 0 -6rpx;
  border: 2rpx solid #fff; border-radius: 50%; box-sizing: border-box;
}
/* 纯 CSS 相册图标 */
.rc-ic-album {
  position: relative; width: 32rpx; height: 28rpx;
  border: 3rpx solid #fff; border-radius: 6rpx; box-sizing: border-box;
}
.rc-ic-album::before {
  content: ''; position: absolute; left: 4rpx; bottom: 4rpx;
  width: 0; height: 0;
  border-left: 9rpx solid transparent; border-right: 9rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}
.rc-ic-album::after {
  content: ''; position: absolute; right: 3rpx; top: 3rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%; background: #fff;
}
.rc-photo-limit {
  font-size: 21rpx; color: var(--m-text-3); text-align: center;
  padding: 10rpx 0 2rpx;
}

/* 结论 */
.rc-radio {
  display: flex; align-items: flex-start; gap: 16rpx;
  border: 2rpx solid var(--m-border); border-radius: 16rpx;
  padding: 18rpx 20rpx; margin-bottom: 14rpx; background: #fafcfe;
}
.rc-radio.checked { border-color: var(--m-accent); background: rgba(30, 111, 224, 0.04); }
.rc-radio radio { transform: scale(0.85); margin-top: 4rpx; }
.rc-radio-t { font-size: 26rpx; font-weight: 700; color: var(--m-navy-800); }
.rc-radio-d { font-size: 20rpx; color: var(--m-text-3); margin-top: 2rpx; }

/* 检查清单 */
.rc-check { display: flex; gap: 14rpx; align-items: flex-start; font-size: 23rpx; color: var(--m-text-2); padding: 7rpx 0; }
.rc-check-ic {
  width: 32rpx; height: 32rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(15, 168, 150, 0.12); color: var(--m-ok);
  font-size: 20rpx; font-weight: 900; display: flex; align-items: center; justify-content: center;
}
.rc-check.no .rc-check-ic { background: rgba(232, 144, 42, 0.14); color: var(--m-watch); }
.rc-error {
  background: var(--m-danger); color: #fff; border-radius: 14rpx;
  padding: 18rpx 22rpx; font-size: 24rpx; margin-bottom: 20rpx;
}

.rc-bottom-space { height: 170rpx; }
.rc-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  background: #fff; border-top: 1rpx solid var(--m-border);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(11, 42, 74, 0.07);
}
.rc-bar button { width: 100%; }
