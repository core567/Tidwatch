<view class="login">
  <view class="login-back" bindtap="onBack">‹ 返回</view>
  <view class="login-brand">
    <view class="login-title">TideWatch</view>
    <view class="login-sub">智慧河流水环境监测 · 移动巡检端</view>
  </view>

  <view class="tw-card login-form">
    <view class="field">
      <text class="field-label">账号</text>
      <input
        class="field-input"
        placeholder="请输入账号"
        value="{{username}}"
        bindinput="onUsername"
        maxlength="32"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPassword"
        maxlength="64"
      />
    </view>

    <view wx:if="{{errorMsg}}" class="login-error">{{errorMsg}}</view>

    <button
      class="tw-btn-primary login-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >登录</button>

    <view class="login-note">
      账号由 PC 端系统管理统一分配。演示环境可用 admin / Admin#2026 登录。
      不登录也可返回，以「演示模式」浏览演示数据。
    </view>
  </view>
</view>
