/* pages/profile/profile.wxss V2 - 巡检人员个人工作中心 */
.pf {
  min-height: 100vh;
  background: var(--m-bg);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* Hero */
.pf-hero { padding-top: 28rpx; padding-bottom: 48rpx; }
.pf-id { display: flex; align-items: center; gap: 20rpx; }
.pf-avatar {
  width: 92rpx; height: 92rpx; border-radius: 28rpx; flex-shrink: 0;
  background: var(--m-grad-accent);
  color: #fff; font-size: 40rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}
.pf-id-main { flex: 1; min-width: 0; }
.pf-name { font-size: 36rpx; font-weight: 800; color: #fff; }
.pf-sub { font-size: 21rpx; color: #a9c4de; margin-top: 6rpx; }
.pf-mode {
  font-size: 20rpx; font-weight: 800; padding: 8rpx 18rpx; border-radius: 999rpx;
  flex-shrink: 0;
}
.pf-mode.is-jwt { background: rgba(15,168,150,.18); color: #7fe0d2; border: 1rpx solid rgba(15,168,150,.4); }
.pf-mode.is-demo { background: rgba(232,144,42,.18); color: #ffc36e; border: 1rpx solid rgba(232,144,42,.4); }
.pf-mode-note {
  margin-top: 18rpx; font-size: 20rpx; color: #ffd9a0; line-height: 1.6;
  background: rgba(232,144,42,.1); border-radius: 12rpx; padding: 12rpx 18rpx;
}

.pf-stats {
  margin-top: 26rpx; display: grid; grid-template-columns: repeat(5, 1fr);
  background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.15);
  border-radius: 24rpx; padding: 22rpx 0;
}
.pf-stat { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.pf-stat-v { font-size: 38rpx; font-weight: 800; color: #fff; line-height: 1; }
.pf-stat-k { font-size: 19rpx; color: #a9c4de; }
.pf-stat-v.t-danger { color: #ff8e8e; }
.pf-stat-v.t-watch { color: #ffc36e; }
.pf-stat-v.t-cyan { color: #6fe3f0; }
.pf-stat-v.t-red { color: #ff9b9b; }
.pf-stat-v.t-ok { color: #7fe0d2; }

.pf-sheet { position: relative; z-index: 3; margin-top: -28rpx; padding: 0 28rpx; }
.pf-sec { margin-bottom: 18rpx; }

/* 首次加载骨架（Hero 常驻） */
.pf-skeleton { padding-top: 4rpx; }
.pf-sk-card {
  background: #fff; border-radius: var(--m-radius-lg);
  padding: 28rpx 30rpx; margin-bottom: 22rpx; box-shadow: var(--m-shadow-card);
}
.pf-sk-bar {
  height: 24rpx; border-radius: 8rpx; margin-bottom: 18rpx;
  background: linear-gradient(90deg,#e8edf3 25%,#f4f7fa 37%,#e8edf3 63%);
  background-size: 400rpx 100%; animation: pf-shimmer 1.3s infinite linear;
}
.pf-sk-bar:last-child { margin-bottom: 0; }
.pf-sk-bar.w40 { width: 40%; }
.pf-sk-bar.w80 { width: 80%; }
.pf-sk-bar.w60 { width: 60%; }
@keyframes pf-shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* 待办 */
.pf-todo {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0; border-bottom: 1rpx dashed #edf1f6;
}
.pf-todo:last-child { border-bottom: 0; }
.pf-todo-hover { background: #f7fafd; }
.pf-todo-main { flex: 1; min-width: 0; }
.pf-todo-title { font-size: 27rpx; font-weight: 700; color: var(--m-navy-800); line-height: 1.45; }
.pf-todo-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.pf-todo-due { font-size: 20rpx; color: var(--m-text-3); }
.pf-todo-reach { font-size: 19rpx; padding: 2rpx 12rpx; }
.pf-logout { color: var(--m-danger); font-weight: 700; }
.pf-reject-comment {
  margin-top: 10rpx; font-size: 21rpx; color: var(--m-danger);
  background: rgba(216,76,76,.06); border-radius: 8rpx; padding: 8rpx 14rpx; line-height: 1.5;
}
.pf-go { font-size: 23rpx; color: var(--m-accent); font-weight: 700; flex-shrink: 0; }
.pf-todo.is-rejected .pf-go { color: var(--m-danger); }
.pf-empty { font-size: 24rpx; color: var(--m-text-3); padding: 12rpx 0 8rpx; }

/* 动态 */
.pf-act { position: relative; padding-left: 30rpx; }
.pf-act::before {
  content: ''; position: absolute; left: 11rpx; top: 14rpx; bottom: 14rpx;
  width: 3rpx; background: #e3eaf2;
}
.pf-act-i { position: relative; padding: 14rpx 0; }
.pf-act-dot {
  position: absolute; left: -26rpx; top: 22rpx; width: 15rpx; height: 15rpx;
  border-radius: 50%; background: #fff; border: 4rpx solid var(--m-accent);
}
.k-rejected .pf-act-dot { border-color: var(--m-danger); }
.k-approved .pf-act-dot { border-color: var(--m-ok); }
.k-submitted .pf-act-dot { border-color: var(--m-cyan); }
.k-created .pf-act-dot { border-color: var(--m-watch); }
.pf-act-text { font-size: 25rpx; font-weight: 700; color: var(--m-text); }
.pf-act-title { font-size: 21rpx; color: var(--m-text-2); margin-top: 3rpx; }
.pf-act-time { font-size: 19rpx; color: var(--m-text-3); margin-top: 3rpx; }

/* 账户与系统 */
.pf-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22rpx 4rpx; border-bottom: 1rpx solid #f1f5f9;
}
.pf-row:last-child { border-bottom: 0; }
.pf-row-k { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--m-text); }
.pf-row-v { font-size: 23rpx; color: var(--m-text-3); }
.pf-link { color: var(--m-accent); font-weight: 700; }
.pf-row-hover { background: #f7fafd; }
.pf-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.pf-dot.ok { background: var(--m-ok); }
.pf-dot.watch { background: var(--m-watch); }
.pf-dot.off { background: var(--m-offline); }
.pf-help {
  margin-top: 8rpx; padding: 16rpx 18rpx; background: #f6f9fc; border-radius: 12rpx;
  font-size: 20rpx; color: var(--m-text-3); line-height: 1.9;
}
