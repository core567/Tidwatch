.rec-taskid {
  font-weight: 600;
  color: #0b2a4a;
  margin-top: 6rpx;
}
.rec-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background: #fbfdff;
}
.rec-count {
  text-align: right;
  margin-top: 8rpx;
}
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.photo-item,
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-add {
  border: 2rpx dashed #b8c6d6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d7186;
  font-size: 24rpx;
  background: #fbfdff;
}
.photo-status {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  font-size: 20rpx;
  text-align: center;
  color: #fff;
  padding: 2rpx 0;
}
.status-pending { background: rgba(93, 113, 134, 0.8); }
.status-uploading { background: rgba(232, 144, 42, 0.9); }
.status-uploaded { background: rgba(18, 165, 148, 0.9); }
.status-failed { background: rgba(216, 76, 76, 0.9); }
.photo-del {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
}
.radio-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
}
.rec-error {
  color: #d84c4c;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}
.rec-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
