/* pages/task-detail/task-detail.wxss V2 */
.td {
  min-height: 100vh;
  background: var(--m-bg);
}

/* Hero */
.td-hero { padding-top: 24rpx; padding-bottom: 64rpx; }
.td-badges { display: flex; gap: 14rpx; }
.td-title { font-size: 36rpx; font-weight: 800; color: #fff; margin: 20rpx 0; line-height: 1.45; }
.td-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.td-chip {
  font-size: 21rpx;
  padding: 7rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.11);
  border: 1rpx solid rgba(255, 255, 255, 0.17);
  color: #dcebfa;
}
.td-chip-id { font-family: monospace; font-size: 19rpx; opacity: 0.8; }

.td-sheet { position: relative; z-index: 3; margin-top: -40rpx; padding: 0 28rpx; }
.td-sec { margin-bottom: 20rpx; }

/* 步骤条 */
.td-steps-card { padding: 30rpx 20rpx 22rpx; }
.td-steps { display: flex; align-items: flex-start; }
.td-step { flex: 1; position: relative; text-align: center; z-index: 2; }
.td-step-dot {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #e6ecf3; color: #94a3b8;
  font-size: 21rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; margin: 0 auto;
  border: 3rpx solid #e6ecf3;
}
.td-step-lb { font-size: 18rpx; color: var(--m-text-3); margin-top: 9rpx; line-height: 1.3; font-weight: 600; }
.td-step::before {
  content: ''; position: absolute; top: 24rpx; left: -50%; width: 100%;
  height: 4rpx; background: #e6ecf3; z-index: 1;
}
.td-step:first-child::before { display: none; }
.td-step.is-done .td-step-dot { background: var(--m-ok); border-color: var(--m-ok); color: #fff; }
.td-step.is-done .td-step-lb { color: var(--m-ok); }
.td-step.is-done::before { background: var(--m-ok); }
.td-step.is-cur .td-step-dot {
  background: #fff; border-color: var(--m-danger); color: var(--m-danger);
  box-shadow: 0 0 0 8rpx rgba(216, 76, 76, 0.13);
}
.td-step.is-cur .td-step-lb { color: var(--m-danger); font-weight: 800; }

/* 退回横幅 */
.td-reject {
  background: rgba(216, 76, 76, 0.07);
  border: 1rpx solid rgba(216, 76, 76, 0.32);
  border-left: 8rpx solid var(--m-danger);
  border-radius: var(--m-radius-md);
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
}
.td-reject-t { font-size: 26rpx; font-weight: 800; color: var(--m-danger); }
.td-reject-c { font-size: 25rpx; margin-top: 12rpx; line-height: 1.65; color: #4a3535; }
.td-reject-f {
  display: flex; justify-content: space-between; margin-top: 14rpx;
  font-size: 21rpx; color: var(--m-text-2);
}

/* KV */
.td-kv {
  display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx;
  padding: 16rpx 0; border-bottom: 1rpx dashed #edf1f6;
}
.td-kv:last-child { border-bottom: 0; }
.td-k { color: var(--m-text-2); font-size: 25rpx; flex-shrink: 0; }
.td-v { font-size: 25rpx; font-weight: 600; color: var(--m-text); text-align: right; flex: 1; }
.td-link { color: var(--m-accent); font-weight: 700; font-size: 25rpx; }

/* 建议测量 */
.td-suggest-note {
  font-size: 21rpx; color: var(--m-text-2); background: #f6f9fc;
  border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.6; margin-bottom: 16rpx;
}
.td-measure-list { display: flex; flex-direction: column; gap: 12rpx; }
.td-measure-i {
  display: flex; align-items: baseline; gap: 14rpx;
  border: 1rpx solid var(--m-border); border-radius: var(--m-radius-sm);
  padding: 16rpx 20rpx;
}
.td-measure-name { font-size: 26rpx; font-weight: 700; color: var(--m-navy-800); }
.td-measure-unit { font-size: 22rpx; color: var(--m-accent); font-weight: 700; }
.td-measure-hint { font-size: 20rpx; color: var(--m-text-3); margin-left: auto; text-align: right; }

/* 提交版本 */
.td-sub { border: 1rpx solid var(--m-border); border-radius: var(--m-radius-md); padding: 22rpx 24rpx; margin-top: 18rpx; }
.td-sub-head { display: flex; justify-content: space-between; align-items: center; }
.td-sub-ver { font-size: 26rpx; font-weight: 800; color: var(--m-navy-800); }
.td-sub-line { display: flex; justify-content: space-between; font-size: 24rpx; margin-top: 12rpx; }
.td-sub-measures { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.td-measure-tag {
  font-size: 21rpx; padding: 6rpx 16rpx; border-radius: 10rpx;
  background: rgba(24, 183, 200, 0.1); color: #0e8c99; font-weight: 600;
}
.td-measure-tag.is-unmeasured { background: var(--offline-bg, rgba(148,163,184,.16)); color: #5b7088; }
.td-sub-note {
  margin-top: 14rpx; font-size: 24rpx; background: #f6f9fc;
  border-radius: 12rpx; padding: 16rpx 20rpx; line-height: 1.6;
}
.td-review { margin-top: 16rpx; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 24rpx; line-height: 1.6; }
.td-review.is-ok { background: rgba(15, 168, 150, 0.09); }
.td-review.is-danger { background: rgba(216, 76, 76, 0.07); }
.td-review-h { display: flex; justify-content: space-between; font-weight: 800; font-size: 23rpx; }
.td-review.is-ok .td-review-h { color: var(--m-ok); }
.td-review.is-danger .td-review-h { color: var(--m-danger); }
.td-review-c { margin-top: 6rpx; color: var(--m-text); }

/* 照片 */
.td-photos { display: flex; flex-wrap: wrap; gap: 16rpx; }
.td-photo { width: 128rpx; height: 128rpx; border-radius: 14rpx; background: #eef3f8; }

/* 终态 */
.td-done { text-align: center; padding: 60rpx 40rpx; }
.td-done-emoji { font-size: 72rpx; }
.td-done-title { font-size: 28rpx; font-weight: 800; color: var(--m-navy-800); margin: 16rpx 0 8rpx; }

.td-bottom-space { height: 170rpx; }

/* 底部操作栏 */
.td-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  background: #fff; border-top: 1rpx solid var(--m-border);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(11, 42, 74, 0.07);
}
.td-bar-btn { width: 100%; }
.td-bar-wait {
  width: 100%; border: 0; border-radius: 24rpx; padding: 26rpx 0;
  background: #edf1f6; color: var(--m-text-3); font-size: 27rpx; font-weight: 700;
}

.err-msg { word-break: break-all; }
.retry-btn { width: 60%; margin-top: 20rpx; }

/* 首次加载骨架（Hero 常驻） */
.td-skeleton { padding-top: 4rpx; }
.td-sk-card {
  background: #fff; border-radius: var(--m-radius-lg);
  padding: 28rpx 30rpx; margin-bottom: 22rpx; box-shadow: var(--m-shadow-card);
}
.td-sk-bar {
  height: 24rpx; border-radius: 8rpx; margin-bottom: 18rpx;
  background: linear-gradient(90deg,#e8edf3 25%,#f4f7fa 37%,#e8edf3 63%);
  background-size: 400rpx 100%; animation: td-sk-shimmer 1.3s infinite linear;
}
.td-sk-bar:last-child { margin-bottom: 0; }
.td-sk-bar.w40 { width: 40%; }
.td-sk-bar.w90 { width: 90%; }
.td-sk-bar.w60 { width: 60%; }
@keyframes td-sk-shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}
