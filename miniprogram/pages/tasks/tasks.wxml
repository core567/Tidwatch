<!-- pages/tasks/tasks.wxml - 巡检工作台 V2 -->
<view class="wk">

  <!-- Hero 常驻：首次加载/切 Tab 也保持深蓝，避免浅灰骨架→深蓝头部的闪白 -->
  <view class="m-hero wk-hero">
    <view class="m-hero-inner">
      <view class="wk-hero-row">
        <view>
          <view class="m-hero-eyebrow">INSPECTION WORKBENCH</view>
          <view class="wk-hi">{{pageState === 'ready' ? greeting : 'TideWatch'}}，巡检员</view>
          <view class="wk-date">{{pageState === 'ready' ? dateText + ' · ' + todoHint : '正在获取任务…'}}</view>
        </view>
        <view class="wk-ws ws-{{wsState}}">
          <view class="wk-ws-dot"></view>{{wsStateText}}
        </view>
      </view>

      <view class="wk-hud">
        <!-- 进度环 -->
        <view class="wk-ring">
          <image src="{{ringIcon}}" class="wk-ring-img" mode="aspectFit" />
          <view class="wk-ring-center">
            <text class="wk-ring-pct">{{progressPct}}%</text>
            <text class="wk-ring-label">已完成</text>
          </view>
        </view>
        <!-- 四指标（点按即筛选） -->
        <view class="wk-hud-grid">
          <view class="wk-hm t-danger" data-key="todo" bindtap="onQuickFilter">
            <text class="wk-hm-v">{{summary.todo}}</text><text class="wk-hm-k">待接收</text>
          </view>
          <view class="wk-hm t-watch" data-key="doing" bindtap="onQuickFilter">
            <text class="wk-hm-v">{{summary.doing}}</text><text class="wk-hm-k">进行中</text>
          </view>
          <view class="wk-hm t-cyan" data-key="review" bindtap="onQuickFilter">
            <text class="wk-hm-v">{{summary.review}}</text><text class="wk-hm-k">待复核</text>
          </view>
          <view class="wk-hm t-ok" data-key="done" bindtap="onQuickFilter">
            <text class="wk-hm-v">{{summary.done}}</text><text class="wk-hm-k">已完成</text>
          </view>
        </view>
      </view>
      <view class="wk-hud-foot">
        <text class="wk-live"><view class="wk-live-dot"></view>WebSocket 实时同步 · 25s 心跳</text>
        <text>统计与列表同源</text>
      </view>
    </view>
  </view>

  <block wx:if="{{pageState === 'error'}}">
    <view class="wk-sheet">
      <m-state type="error" title="任务加载失败" desc="{{errorMsg}}" retry-text="重试" bind:retry="loadTasks" />
    </view>
  </block>

  <block wx:else>
    <m-connection-bar tone="{{connTone}}" text="{{connText}}" />

    <view class="wk-sheet">
      <!-- 首次加载骨架（Hero 已常驻，仅内容区占位） -->
      <view wx:if="{{pageState === 'loading'}}" class="wk-skeleton">
        <view class="wk-sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
          <view class="wk-sk-bar w40"></view>
          <view class="wk-sk-bar w90"></view>
          <view class="wk-sk-bar w60"></view>
        </view>
      </view>

      <block wx:else>
      <!-- 高优先级横滑 -->
      <block wx:if="{{hotTasks.length > 0}}">
        <view class="wk-sec-head">
          <view class="m-sec-title">高优先级</view>
          <view class="wk-sec-more">HIGH · 未完成 {{hotTasks.length}}</view>
        </view>
        <scroll-view scroll-x class="wk-hot-scroll" enhanced show-scrollbar="{{false}}">
          <view
            wx:for="{{hotTasks}}"
            wx:key="taskId"
            class="wk-hot {{item.status === 'IN_PROGRESS' && item.statusText === '需重提' ? 'amber' : 'blue'}}"
            data-id="{{item.taskId}}"
            bindtap="openTask"
          >
            <view class="wk-hot-top">
              <text class="wk-hot-status">{{item.statusText}} · {{item.status}}</text>
              <text class="wk-hot-flag">⚑</text>
            </view>
            <view class="wk-hot-name">{{item.title}}</view>
            <view class="wk-hot-meta">
              {{reachNames[item.reachId] || item.reachId}} · {{actionNames[item.actionType] || item.actionType}}<text wx:if="{{item.eventId}}"> · {{item.eventId}}</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <!-- 最近动态（全部来自任务真实字段） -->
      <block wx:if="{{activities.length > 0}}">
        <view class="wk-sec-head">
          <view class="m-sec-title">最近动态</view>
          <view class="wk-sec-more">实时派生</view>
        </view>
        <view class="m-card wk-tl-card">
          <view class="wk-tl">
            <view
              wx:for="{{activities}}"
              wx:key="taskId"
              class="wk-tl-i {{item.kindClass}}"
              data-id="{{item.taskId}}"
              bindtap="openTask"
            >
              <view class="wk-tl-t">
                <text>{{item.kindText}} · {{item.title}}</text>
                <text class="wk-tl-time">{{item.atText}}</text>
              </view>
              <view class="wk-tl-d">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </block>

      <!-- 筛选 pills（计数与四格同源） -->
      <scroll-view scroll-x class="wk-pills" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{filters}}"
          wx:key="key"
          class="wk-pill {{activeFilter === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFilter"
        >{{filterLabels[index]}}</view>
      </scroll-view>

      <!-- 任务列表 -->
      <block wx:if="{{!listEmpty}}">
        <view
          wx:for="{{tasks}}"
          wx:key="taskId"
          class="wk-task {{item.isUrgent ? 'urgent' : (item.statusText === '需重提' ? 'reject' : '')}}"
          data-id="{{item.taskId}}"
          bindtap="openTask"
        >
          <view class="wk-task-body">
            <view class="wk-task-top">
              <text class="wk-task-name">{{item.title}}</text>
              <text class="m-badge m-badge-{{item.statusTone}}">{{item.statusText}}</text>
            </view>
            <view class="wk-task-meta">
              <text class="m-chip m-chip-accent">{{reachNames[item.reachId] || item.reachId}}</text>
              <text class="m-chip">{{actionNames[item.actionType] || item.actionType}}</text>
              <text wx:if="{{item.eventId}}" class="m-chip m-chip-event">{{item.eventId}}</text>
            </view>
            <view class="wk-task-foot">
              <text class="wk-due {{item.isUrgent ? 'red' : ''}}">
                <block wx:if="{{item.statusText === '需重提'}}">↺ {{item.latestReview.comment || '需补充后重新提交'}}</block>
                <block wx:else>截止 {{item.dueAtText}}</block>
              </text>
              <view class="wk-task-right">
                <text wx:if="{{item.priority === 'HIGH'}}" class="m-badge m-badge-outline">HIGH</text>
                <text class="wk-chev">›</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <m-state
        wx:else
        type="empty"
        title="该分类下暂无任务"
        desc="可切换其他分类，下拉刷新或等待实时推送"
      />

      <!-- 快捷入口 -->
      <view class="wk-sec-head" style="margin-top:8rpx">
        <view class="m-sec-title">快捷入口</view>
      </view>
      <view class="wk-quick">
        <view class="wk-quick-i" bindtap="goEvents">
          <view class="wk-quick-ic q1">⚠</view>
          <view class="wk-quick-t">
            <view class="wk-quick-name">异常事件</view>
            <view class="wk-quick-desc">活动中 {{activeEventCount}}</view>
          </view>
          <text class="wk-chev">›</text>
        </view>
        <view class="wk-quick-i" bindtap="goReaches">
          <view class="wk-quick-ic q2">≈</view>
          <view class="wk-quick-t">
            <view class="wk-quick-name">水环境监测</view>
            <view class="wk-quick-desc">3 断面数据</view>
          </view>
          <text class="wk-chev">›</text>
        </view>
      </view>
      </block>
    </view>
  </block>
</view>
