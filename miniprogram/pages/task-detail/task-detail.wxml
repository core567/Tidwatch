<view class="container">
  <block wx:if="{{uiState === 'loading'}}">
    <view class="tw-state">加载中…</view>
  </block>
  <block wx:elif="{{uiState === 'error'}}">
    <view class="tw-state">
      <view>任务加载失败</view>
      <view class="tw-muted err-msg">{{errorMsg}}</view>
      <button class="tw-btn-primary retry-btn" bindtap="load">重试</button>
    </view>
  </block>
  <block wx:else>
    <view class="tw-card">
      <view class="tw-card-title">{{task.title}}</view>
      <view class="row"><text class="tw-muted">任务编号</text><text>{{task.taskId}}</text></view>
      <view class="row"><text class="tw-muted">监测点</text><text>{{task.reachId}}</text></view>
      <view class="row"><text class="tw-muted">动作类型</text><text>{{actionText}}</text></view>
      <view class="row"><text class="tw-muted">优先级</text>
        <text class="tw-badge {{task.priority === 'HIGH' ? 'tw-badge-danger' : 'tw-badge-ok'}}">{{task.priority}}</text>
      </view>
      <view class="row"><text class="tw-muted">状态</text><text>{{task.status}}</text></view>
      <view class="row"><text class="tw-muted">截止时间</text><text>{{dueAtText}}</text></view>
      <view class="row row-top"><text class="tw-muted">派发理由</text><text class="reason">{{task.reason || '—'}}</text></view>
    </view>

    <view class="tw-card" wx:if="{{task.eventId}}">
      <view class="tw-card-title">关联异常事件</view>
      <view class="link-row" data-id="{{task.eventId}}" bindtap="openEvent">
        <text class="link">{{task.eventId}}</text>
        <text class="tw-muted">查看事件时间线与证据 ›</text>
      </view>
    </view>

    <view class="tw-card" wx:if="{{submittedPhotos.length > 0}}">
      <view class="tw-card-title">巡检照片（{{submittedPhotos.length}}）</view>
      <view class="photo-grid">
        <image
          wx:for="{{submittedPhotos}}"
          wx:key="attachmentId"
          src="{{item.tempPath}}"
          mode="aspectFill"
          class="photo-img"
          data-src="{{item.tempPath}}"
          bindtap="previewImage"
        />
      </view>
    </view>

    <view class="actions">
      <button
        wx:if="{{task.status === 'PENDING'}}"
        class="tw-btn-primary"
        bindtap="onAccept"
      >接收任务</button>
      <button
        wx:if="{{task.status === 'ACCEPTED'}}"
        class="tw-btn-primary"
        bindtap="onStart"
      >开始巡检</button>
      <button
        wx:if="{{task.status === 'IN_PROGRESS'}}"
        class="tw-btn-primary"
        data-id="{{task.taskId}}"
        bindtap="goRecord"
      >填写巡检记录</button>
    </view>

    <view class="tw-muted hint">
      任务状态由后端统一校验并写入 Run Trace；非法流转会被拒绝。M3 完成业务对接。
    </view>
  </block>
</view>
