/* m-hero 内部布局（外观类 .m-hero/.m-hero-* 中皮肤在 tokens.wxss，这里补结构样式） */
.m-hero-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}
.m-hero-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #7fb2e0;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.m-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}
.m-hero-sub {
  font-size: 23rpx;
  color: #a9c4de;
  margin-top: 8rpx;
  line-height: 1.55;
}
