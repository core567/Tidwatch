<view class="container">
  <view class="topo-note">示意拓扑：上游 A → 中游 B → 下游 C（真实站点坐标待核实）</view>

  <block wx:if="{{uiState === 'loading'}}">
    <view class="tw-state">加载中…</view>
  </block>
  <block wx:elif="{{uiState === 'error'}}">
    <view class="tw-state">
      <view>监测点加载失败</view>
      <view class="tw-muted err-msg">{{errorMsg}}</view>
      <button class="tw-btn-primary retry-btn" bindtap="loadReaches">重试</button>
    </view>
  </block>
  <block wx:elif="{{uiState === 'empty'}}">
    <view class="tw-state">暂无监测点数据</view>
  </block>
  <block wx:else>
    <view
      wx:for="{{reaches}}"
      wx:key="reachId"
      class="tw-card reach-card"
      data-id="{{item.reachId}}"
      bindtap="openReach"
    >
      <view class="reach-head">
        <text class="reach-name">{{item.name}}</text>
        <text class="tw-badge {{badgeClass[item.onlineStatus] || 'tw-badge-offline'}}">
          {{statusNames[item.onlineStatus] || item.onlineStatus}}
        </text>
      </view>
      <view class="reach-row">
        <text class="tw-muted">最后有效观测</text>
        <text>{{item.lastObservedAtText}}</text>
      </view>
      <view class="reach-row">
        <text class="tw-muted">坐标状态</text>
        <text>{{item.coordinateStatus === 'VERIFIED' ? '已核实' : '逻辑点（示意）'}}</text>
      </view>
      <view class="reach-row" wx:if="{{item.officialCandidateName}}">
        <text class="tw-muted">官方候选断面</text>
        <text>{{item.officialCandidateName}}（待核实）</text>
      </view>
    </view>
  </block>
</view>
