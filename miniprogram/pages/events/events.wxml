<view class="container">
  <view class="filter-bar">
    <view
      wx:for="{{filters}}"
      wx:key="value"
      class="filter-item {{activeStatus === item.value ? 'filter-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{uiState === 'loading'}}">
    <view class="tw-state">加载中…</view>
  </block>
  <block wx:elif="{{uiState === 'error'}}">
    <view class="tw-state">
      <view>事件加载失败</view>
      <view class="tw-muted err-msg">{{errorMsg}}</view>
      <button class="tw-btn-primary retry-btn" bindtap="loadEvents">重试</button>
    </view>
  </block>
  <block wx:elif="{{uiState === 'empty'}}">
    <view class="tw-state">当前筛选条件下无异常事件</view>
  </block>
  <block wx:else>
    <view
      wx:for="{{events}}"
      wx:key="eventId"
      class="tw-card event-card"
      data-id="{{item.eventId}}"
      bindtap="openEvent"
    >
      <view class="event-head">
        <text class="event-id">{{item.eventId}}</text>
        <text class="tw-badge {{badgeClass[item.status] || 'tw-badge-offline'}}">{{statusNames[item.status] || item.status}}</text>
      </view>
      <view class="event-title">{{item.title}}</view>
      <view class="event-meta">
        <text>范围 {{item.scopeText}}</text>
        <text class="tw-muted">v{{item.version}}</text>
      </view>
      <view class="tw-muted event-time">更新于 {{item.updatedAtText}}</view>
    </view>
  </block>
</view>
