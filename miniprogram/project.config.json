{
  "miniprogramRoot": "./",
  "projectname": "tidewatch-miniprogram",
  "description": "TideWatch 移动巡检端（微信原生小程序 + TypeScript）",
  "appid": "wx1c7d5cf83b4d1004",
  "compileType": "miniprogram",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "useCompilerPlugins": [
      "typescript"
    ],
    "ignoreUploadUnusedFiles": true,
    "ignoreDevUnusedFiles": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [
      {
        "value": "node_modules",
        "type": "folder"
      },
      {
        "value": "dist-test",
        "type": "folder"
      },
      {
        "value": "scripts",
        "type": "folder"
      },
      {
        "value": "tests",
        "type": "folder"
      },
      {
        "value": "tsconfig.json",
        "type": "file"
      }
    ],
    "include": []
  },
  "condition": {},
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}