# TideWatch backend environment example
# 复制为 backend/.env 并按需修改；.env 不入库。

# SQLite（留空则默认使用仓库根目录 data/tidewatch.db；亦可显式指定）
# DATABASE_URL=sqlite:///D:/Tidwatch01/data/tidewatch.db

# JWT
# JWT（生产环境请用 >=32 字节随机串，例如 python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=dev-only-change-me-0123456789abcdef-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS（PC Web Vite dev server）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MQTT（M1 启用；M0 仅自检脚本使用）
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=tidewatch/v1
MQTT_CLIENT_ID=tidewatch-backend
MQTT_ENABLED=false
# 超过该秒数无新数据，在线断面转为 STALE（离线由 LWT 处理）
MQTT_STALE_SECONDS=30

# 规则版本（教学演示阈值，非官方标准）
RULE_VERSION=demo-rules-v1

# 上传
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# 官方自动监测实时水质（国家地表水自动监测实时数据发布系统）
# 平台含反爬声明：默认关闭，仅 P12 手动拉取；同一站点 30 分钟内命中缓存
OFFICIAL_AUTO_ENABLED=false
OFFICIAL_AUTO_CACHE_MINUTES=30
# 实测官方常态为每日 00:00 一条快照，超过该分钟数标注"数据过期"
OFFICIAL_AUTO_STALE_MINUTES=1500
OFFICIAL_AUTO_TIMEOUT_SECONDS=20
# 多断面连续查询节流（避免触发平台反爬）
OFFICIAL_AUTO_REQUEST_INTERVAL_SECONDS=1.5
OFFICIAL_AUTO_RETRY_DELAY_SECONDS=2.0
