.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 48rpx;
  background: linear-gradient(180deg, #0b2a4a 0%, #123c66 38%, #f2f5f9 38%);
}
.login-brand {
  text-align: center;
  margin-bottom: 56rpx;
}
.login-title {
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.login-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  margin-top: 12rpx;
}
.login-form {
  padding: 40rpx 32rpx;
}
.field {
  margin-bottom: 28rpx;
}
.field-label {
  display: block;
  font-size: 26rpx;
  color: #5d7186;
  margin-bottom: 12rpx;
}
.field-input {
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  background: #fbfdff;
}
.login-error {
  color: #d84c4c;
  font-size: 24rpx;
  margin: 8rpx 0 20rpx;
}
.login-btn {
  margin-top: 8rpx;
}
.login-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #8aa0b8;
  line-height: 1.6;
}
