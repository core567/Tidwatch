.m-conn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  font-size: 22rpx;
}
.m-conn-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.m-conn-text { line-height: 1.4; }
.m-conn.is-offline {
  background: rgba(216, 76, 76, 0.08);
  color: #c0392b;
}
.m-conn.is-offline .m-conn-dot { background: #d84c4c; }
.m-conn.is-stale {
  background: rgba(232, 144, 42, 0.1);
  color: #b06a12;
}
.m-conn.is-stale .m-conn-dot { background: #e8902a; }
