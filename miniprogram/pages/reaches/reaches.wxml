<!-- pages/reaches/reaches.wxml - 水环境监测 V2 -->
<view class="rv">

  <block wx:if="{{pageState === 'loading'}}"><m-state type="loading" /></block>
  <block wx:elif="{{pageState === 'error'}}">
    <m-state type="error" title="监测数据加载失败" desc="{{errorMsg}}" bind:retry="load" />
  </block>

  <block wx:else>
    <view class="m-hero rv-hero">
      <view class="m-hero-inner">
        <view class="rv-hero-row">
          <view>
            <view class="m-hero-eyebrow">WATER ENVIRONMENT</view>
            <view class="rv-title">水环境监测</view>
            <view class="rv-sub">连续观测为 MQTT 模拟链路（明确标注）· 官方站为快照数据</view>
          </view>
          <view class="rv-link-pill {{linkOfflineCount > 0 ? 'off' : 'on'}}">
            <view class="rv-link-dot"></view>{{linkOfflineCount > 0 ? '链路中断 ' + linkOfflineCount : '链路在线'}}
          </view>
        </view>

        <!-- 汉江拓扑（呼应 PC 3D 河流走廊） -->
        <view class="rv-river-wrap">
          <view class="rv-river-label">
            <text>HAN RIVER · WUHAN REACH</text><text>FLOW →</text>
          </view>
          <view class="rv-river">
            <view class="rv-river-line"></view>
            <view
              wx:for="{{cards}}"
              wx:key="reachId"
              class="rv-node-wrap"
              style="left: {{index === 0 ? '4%' : index === 1 ? '44%' : '84%'}}"
            >
              <view class="rv-node {{item.eventId ? 'alert' : (item.onlineStatus === 'ONLINE' ? 'online' : 'off')}}">{{item.letter}}</view>
              <view class="rv-node-label">{{item.name}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <m-connection-bar tone="{{connTone}}" text="{{connText}}" />

    <view class="rv-sheet">
      <!-- 新鲜度/风险概览 -->
      <view class="rv-fresh">
        <view class="rv-fresh-i">
          <view class="rv-fresh-dot {{activeEventTotal > 0 ? 'r' : 'g'}}"></view>
          活动异常 {{activeEventTotal}}
        </view>
        <view class="rv-fresh-i">
          <view class="rv-fresh-dot {{blindTotal > 0 ? 'o' : 'g'}}"></view>
          开放盲区 {{blindTotal}}
        </view>
        <view class="rv-fresh-i">
          <view class="rv-fresh-dot {{linkOfflineCount > 0 ? 'o' : 'g'}}"></view>
          链路 {{linkOfflineCount > 0 ? '中断' : '在线'}}
        </view>
      </view>

      <view
        wx:for="{{cards}}"
        wx:key="reachId"
        class="rv-card"
        data-id="{{item.reachId}}"
        bindtap="openReach"
      >
        <view class="rv-card-head">
          <view class="rv-card-id">
            <view class="rv-letter {{item.onlineStatus === 'ONLINE' ? 'grad' : ''}}">
              {{item.letter}}<text>{{item.roleShort}}</text>
            </view>
            <view>
              <view class="rv-name">{{item.name}}</view>
              <view class="rv-station">{{item.stationText}} · {{item.coordinateStatus === 'VERIFIED' ? '坐标已核实' : 'LOGICAL'}}</view>
            </view>
          </view>
          <view class="rv-link-badge {{item.onlineStatus === 'ONLINE' ? 'on' : (item.onlineStatus === 'STALE' ? 'stale' : 'off')}}">
            ◉ {{item.onlineStatus === 'ONLINE' ? '链路在线' : item.onlineStatus === 'STALE' ? '数据陈旧' : '链路中断'}}
          </view>
        </view>

        <view class="rv-metrics">
          <view wx:for="{{item.metrics}}" wx:for-item="mm" wx:key="key" class="rv-metric">
            <view class="rv-mv m-num">{{mm.value}}<small>{{mm.value === '—' ? '' : ' ' + mm.unit}}</small></view>
            <view class="rv-mk">{{mm.label}}</view>
            <view class="rv-mt">{{item.seenText}}</view>
          </view>
        </view>

        <view class="rv-card-foot">
          <view class="rv-foot-left">
            <text>最后有效观测 <text class="m-num">{{item.seenText}}</text></text>
            <text class="m-src m-src-sim" wx:if="{{item.latestAt}}">模拟数据</text>
            <text wx:if="{{item.blindCount > 0}}" class="rv-blind">开放盲区 {{item.blindCount}}</text>
            <text wx:if="{{item.eventId}}" class="rv-event" catchtap="openEvent" data-id="{{item.eventId}}">{{item.eventId}}</text>
          </view>
          <text class="rv-detail-link">断面详情 ›</text>
        </view>
      </view>

      <view class="rv-note">
        「链路中断」仅表示 MQTT 模拟源停止推送；上方数值是最后有效观测（带时间与来源）。
        离线不等于现场正常，也不代表水质异常。官方自动站数据为月度/拉取时点快照，不画连续曲线。
      </view>
    </view>
  </block>
</view>
