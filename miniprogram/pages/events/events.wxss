/* pages/events/events.wxss V2 */
.ev {
  min-height: 100vh;
  background: #edf1f6;
  background: var(--m-bg);
}

/* Hero */
.ev-hero { padding-top: 22rpx; padding-bottom: 40rpx; }
.ev-title { font-size: 36rpx; font-weight: 800; color: #fff; margin-top: 4rpx; }
.ev-sub { font-size: 20rpx; color: #a9c4de; margin-top: 6rpx; }
.ev-hud {
  margin-top: 22rpx; display: grid; grid-template-columns: repeat(4, 1fr);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 24rpx; padding: 20rpx 0;
}
.ev-hud-i { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.ev-hud-v { font-size: 40rpx; font-weight: 800; color: #fff; line-height: 1; }
.ev-hud-k { font-size: 20rpx; color: #a9c4de; }
.ev-hud-v.t-danger { color: #ff8e8e; }
.ev-hud-v.t-watch { color: #ffc36e; }
.ev-hud-v.t-ok { color: #7fe0d2; }

.ev-sheet { position: relative; z-index: 3; margin-top: -28rpx; padding: 0 28rpx; }

/* 筛选：四等分 flex，任何屏宽都完整显示不裁切；超长文字省略 */
.ev-filter-bar { display: flex; gap: 12rpx; margin: 8rpx 0 22rpx; }
.ev-filter-item {
  flex: 1 1 0;
  min-width: 0;
  text-align: center;
  padding: 13rpx 4rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--m-border);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--m-text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ev-filter-item.is-active {
  background: var(--m-navy-800);
  border-color: var(--m-navy-800);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(11, 42, 74, 0.25);
}

/* 首次加载骨架（Hero 常驻，仅内容区占位） */
.ev-skeleton { padding-top: 4rpx; }
.ev-sk-card {
  background: #fff; border-radius: var(--m-radius-lg);
  padding: 28rpx 30rpx; margin-bottom: 22rpx;
  box-shadow: var(--m-shadow-card);
}
.ev-sk-bar {
  height: 24rpx; border-radius: 8rpx; margin-bottom: 18rpx;
  background: linear-gradient(90deg, #e8edf3 25%, #f4f7fa 37%, #e8edf3 63%);
  background-size: 400rpx 100%;
  animation: ev-shimmer 1.3s infinite linear;
}
.ev-sk-bar:last-child { margin-bottom: 0; }
.ev-sk-bar.w40 { width: 40%; }
.ev-sk-bar.w80 { width: 80%; }
.ev-sk-bar.w60 { width: 60%; }
@keyframes ev-shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* 事件卡 */
.ev-card {
  background: #fff; border-radius: var(--m-radius-lg);
  margin-bottom: 22rpx; padding: 28rpx 30rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.7);
  box-shadow: var(--m-shadow-card);
  position: relative;
}
.ev-card::before {
  content: ''; position: absolute; left: 0; top: 30rpx; bottom: 30rpx;
  width: 8rpx; border-radius: 0 6rpx 6rpx 0;
  background: var(--m-danger);
}
.ev-card.is-done::before { background: var(--m-ok); }
.ev-card-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.ev-card-id { display: flex; align-items: center; gap: 14rpx; }
.ev-id { font-size: 26rpx; font-weight: 800; color: var(--m-danger); }
.ev-trigger {
  font-size: 20rpx; color: var(--m-text-2);
  background: #f1f5f9; border-radius: 8rpx; padding: 4rpx 14rpx;
}
.ev-card-title { font-size: 29rpx; font-weight: 700; color: var(--m-navy-800); margin: 16rpx 0; line-height: 1.45; }
.ev-card-meta { display: flex; flex-wrap: wrap; gap: 10rpx; }
.ev-card-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #f1f5f9;
}
.ev-updated { font-size: 21rpx; color: var(--m-text-3); }
.ev-go { font-size: 22rpx; color: var(--m-accent); font-weight: 700; }
